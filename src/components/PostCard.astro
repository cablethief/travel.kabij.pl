---
import PostImage from './PostImage.astro';

interface Props {
  href: string;
  title: string;
  author: string;
  pubDate: Date;
  summary?: string;
  coverImage?: { filename: string; author: string; postSlug: string; alt: string };
}
const { href, title, author, pubDate, summary, coverImage } = Astro.props;
---

<article>
  {coverImage && <PostImage {...coverImage} />}
  <h2><a href={href}>{title}</a></h2>
  <p>
    <span>{author}</span> ·
    <time datetime={pubDate.toISOString()}>{pubDate.toLocaleDateString()}</time>
  </p>
  {summary && <p>{summary}</p>}
</article>
