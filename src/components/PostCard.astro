---
interface Props {
  href: string;
  title: string;
  author: string;
  pubDate: Date;
}
const { href, title, author, pubDate } = Astro.props;

const dateLabel = pubDate
  .toLocaleDateString('en-GB', { day: '2-digit', month: 'short', year: 'numeric' })
  .toUpperCase();
---

<a class="board-row" href={href}>
  <span class="board-row__date">{dateLabel}</span>
  <h2 class="board-row__title">{title}</h2>
  <span class="board-row__author">{author}</span>
</a>

<style>
  .board-row {
    display: flex;
    align-items: baseline;
    gap: 1rem;
    padding: 0.85rem 1.25rem;
    background: var(--board);
    color: var(--paper);
    text-decoration: none;
    border-bottom: 1px solid var(--board-line);
  }
  .board-row:first-of-type {
    border-top: 1px solid var(--board-line);
  }
  .board-row:hover,
  .board-row:focus-visible {
    background: var(--board-hover);
  }

  .board-row__date {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.1em;
    color: var(--amber);
    white-space: nowrap;
  }

  .board-row__title {
    font-family: var(--font-display);
    font-size: 1.1rem;
    font-weight: 700;
    color: var(--paper);
    margin: 0;
    flex: 1;
  }

  .board-row__author {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--paper);
    opacity: 0.75;
    white-space: nowrap;
  }

  @media (max-width: 32rem) {
    .board-row {
      flex-wrap: wrap;
    }
    .board-row__author {
      display: none;
    }
  }
</style>
