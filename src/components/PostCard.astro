---
import PostImage from './PostImage.astro';

interface Props {
  href: string;
  title: string;
  author: string;
  pubDate: Date;
  summary?: string;
  coverImage?: { filename: string; author: string; postSlug: string; alt: string };
  index?: number;
}
const { href, title, author, pubDate, summary, coverImage, index = 0 } = Astro.props;

const dateLabel = pubDate
  .toLocaleDateString('en-GB', { day: '2-digit', month: 'short', year: 'numeric' })
  .toUpperCase();
---

<a class="board-row" href={href} style={`--i: ${index}`}>
  {
    coverImage && (
      <div class="board-row__thumb">
        <PostImage {...coverImage} />
      </div>
    )
  }
  <div class="board-row__body">
    <span class="board-row__date">{dateLabel}</span>
    <h2 class="board-row__title">{title}</h2>
    {summary && <p class="board-row__summary">{summary}</p>}
  </div>
  <span class="board-row__author">{author}</span>
</a>

<style>
  .board-row {
    display: grid;
    grid-template-columns: auto 1fr auto;
    gap: 1.25rem;
    align-items: center;
    padding: 1.1rem 1.25rem;
    background: var(--board);
    color: var(--paper);
    text-decoration: none;
    border-bottom: 1px solid var(--board-line);
    transition: background-color 0.15s ease;
  }
  .board-row:first-of-type {
    border-top: 1px solid var(--board-line);
  }
  .board-row:hover,
  .board-row:focus-visible {
    background: var(--board-hover);
  }

  .board-row__thumb {
    width: 4.5rem;
    height: 4.5rem;
    overflow: hidden;
    border: 1px solid var(--board-line);
  }
  .board-row__thumb :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .board-row__date {
    display: block;
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.1em;
    color: var(--amber);
    margin-bottom: 0.3rem;
  }

  .board-row__title {
    font-family: var(--font-display);
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--paper);
    margin: 0 0 0.2rem;
    transform-origin: top center;
  }

  .board-row__summary {
    margin: 0;
    font-family: var(--font-body);
    font-size: 0.9rem;
    color: #b9c2ba;
    max-width: 34rem;
  }

  .board-row__author {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--paper);
    opacity: 0.75;
    white-space: nowrap;
  }

  /* The signature moment: rows flip into place like a split-flap board
     cycling to a new destination. Staggered per row via --i. Skipped
     entirely under reduced motion, not just slowed down. */
  @media (prefers-reduced-motion: no-preference) {
    .board-row__title {
      animation: flip-in 0.5s ease-out both;
      animation-delay: calc(var(--i, 0) * 70ms);
    }
  }

  @keyframes flip-in {
    0% {
      transform: rotateX(85deg);
      opacity: 0;
    }
    60% {
      transform: rotateX(-8deg);
      opacity: 1;
    }
    100% {
      transform: rotateX(0deg);
    }
  }

  @media (max-width: 40rem) {
    .board-row {
      grid-template-columns: auto 1fr;
    }
    .board-row__author {
      display: none;
    }
  }
</style>
