---
import { Image } from 'astro:assets';
import { resolveImageSrc } from '../lib/images';

interface Props {
  src: string;
  alt: string;
  width: number;
  height: number;
}
const { src, alt, width, height } = Astro.props;
const resolved = resolveImageSrc(src);
---

{
  import.meta.env.DEV ? (
    <img src={resolved} alt={alt} width={width} height={height} loading="lazy" decoding="async" />
  ) : (
    <Image src={resolved} alt={alt} width={width} height={height} loading="lazy" />
  )
}
