---
import { resolveImageSrc } from '../lib/images';

interface Props {
  filename: string;
  author: string;
  postSlug: string;
  alt: string;
}
const { filename, author, postSlug, alt } = Astro.props;
const src = resolveImageSrc(filename, author, postSlug, import.meta.env.DEV);
---

<img src={src} alt={alt} loading="lazy" decoding="async" />
