---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

export async function getStaticPaths() {
  const posts = await getCollection('posts', ({ data }) => !data.draft);
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);

const dateLabel = post.data.pubDate
  .toLocaleDateString('en-GB', { day: '2-digit', month: 'short', year: 'numeric' })
  .toUpperCase();
---

<BaseLayout title={post.data.title} description={post.data.summary}>
  <article class="story">
    <p class="story__back"><a href="/">&larr; All departures</a></p>
    <h1 class="story__title">{post.data.title}</h1>
    <p class="story__meta">
      {post.data.author} · <time datetime={post.data.pubDate.toISOString()}>{dateLabel}</time>
    </p>
    <div class="story__prose">
      <Content />
    </div>
  </article>
</BaseLayout>

<style>
  .story__back {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }
  .story__back a {
    color: var(--ink-soft);
    text-decoration: none;
  }
  .story__back a:hover {
    color: var(--teal);
  }

  .story__title {
    font-size: 2.25rem;
    margin-bottom: 1rem;
  }

  .story__meta {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--ink-soft);
    margin-bottom: 2.5rem;
  }

  .story__prose {
    font-size: 1.0625rem;
  }
  .story__prose :global(p) {
    margin: 0 0 1.4em;
  }
  .story__prose :global(img) {
    width: 100%;
    height: auto;
    border: 1px solid var(--board-line);
    margin: 2rem 0;
  }
  .story__prose :global(h2) {
    margin-top: 2.5em;
  }
</style>
